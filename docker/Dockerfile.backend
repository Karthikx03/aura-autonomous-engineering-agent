# AURA backend -- FastAPI application server.
FROM python:3.12-slim

WORKDIR /app

# System deps: git is used by GitPython, gcc for any C-extension wheels
# without prebuilt manylinux binaries for this platform.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git gcc \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ ./

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
