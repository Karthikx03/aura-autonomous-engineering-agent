# ---------------------------------------------------------------------------
# AURA configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` in the repository root (or in backend/, both are
# read via pydantic-settings' env_file) and fill in only what you need.
# AURA runs with ZERO keys set: DEFAULT_LLM_PROVIDER=mock uses the
# deterministic offline MockProvider, which is what CI and the demo script
# use. Never commit a real .env file -- it is gitignored on purpose.
# ---------------------------------------------------------------------------

# --- App ---
APP_NAME=AURA
ENVIRONMENT=development
DEBUG=true

# --- LLM provider selection ---
# One of: mock | openai | anthropic | gemini | ollama
# "mock" requires no API key and is what CI/tests/demo use by default.
DEFAULT_LLM_PROVIDER=mock

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# Google Gemini
GOOGLE_API_KEY=AIza...
GOOGLE_MODEL=gemini-1.5-pro

# Ollama (local models, no API key needed -- just a reachable server)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Persistence ---
# SQLite is the default for local dev/tests. docker-compose overrides this
# to point at the postgres service.
DATABASE_URL=sqlite+aiosqlite:///./aura.db
REDIS_URL=redis://localhost:6379/0

# --- Orchestrator ---
# Hard cap on the plan->implement->test->debug retry loop. There is no
# infinite retry; the task is marked failed once this is exhausted.
MAX_ITERATIONS=5

# --- Sandbox ---
# When true, agent-run commands execute inside SandboxManager (Docker
# container when a daemon is reachable, otherwise a reduced-isolation
# local-subprocess fallback -- see SECURITY.md before relying on this for
# untrusted code).
SANDBOX_ENABLED=true
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEMORY_LIMIT_MB=512
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_NETWORK_DISABLED=true
SANDBOX_WORKDIR=~/.aura/sandboxes

# --- Security ---
# Number of high/critical SecurityAgent findings that blocks an auto-commit.
SECURITY_MAX_FINDINGS_BEFORE_BLOCK=1

# --- Observability ---
LOG_LEVEL=INFO
METRICS_ENABLED=true
